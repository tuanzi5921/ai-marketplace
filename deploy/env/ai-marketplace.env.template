# 企业 AI 应用市场 — 后端运行时环境变量（应用层 192.168.1.132）
# 部署位置：/aitest/app/config/ai-marketplace.env   权限必须 600，属主 aiuser
#
# 本文件是唯一存放明文口令的地方，不要提交到代码库、不要复制到聊天工具。
# 键名与 backend/src/main/resources/application.yml 中的 ${XXX:默认值} 一一对应。
# __占位符__ 由 setup-app-server.sh 部署时替换为真实随机值。

# ---------- 数据库（数据层 131）----------
DB_HOST=192.168.1.131
DB_PORT=3306
DB_NAME=ai_marketplace
DB_USER=ai_market
DB_PWD=__DB_PASSWORD__

# ---------- Redis（数据层 131）----------
REDIS_HOST=192.168.1.131
REDIS_PORT=6379
REDIS_PWD=__REDIS_PASSWORD__

# ---------- JWT ----------
# HS256 密钥，长度必须足够；泄露等于任何人可伪造登录态，更换后所有已发 token 失效
JWT_SECRET=__JWT_SECRET__

# ---------- 文件存储 ----------
# 作品包落盘根目录，按 {basePath}/{yyyyMMdd}/{uuid}{ext} 组织
STORAGE_BASE_PATH=/aitest/storage/files

# ---------- 企业微信 ----------
# 留空则 SSO 与消息推送均不可用；开启推送前必须先填 corp-id / app-secret
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_GROUP_WEBHOOK=
WECOM_MESSAGE_ENABLED=false
# 企微授权后浏览器回跳地址。
# 注意：前端 workbench 的 router 里没有 /oauth/callback 路由，
# 真正读取 code 的是 /login 页面（Login.vue 的 onMounted），所以这里必须指向 /login。
# 上线用了域名或 HTTPS 后请同步修改，并在企微后台把它登记为可信域名。
WECOM_AUTH_CALLBACK=http://192.168.1.132/login

# ---------- AI 评审（v1 关闭）----------
REVIEW_AI_ENABLED=false
REVIEW_AI_ENDPOINT=
REVIEW_AI_API_KEY=
