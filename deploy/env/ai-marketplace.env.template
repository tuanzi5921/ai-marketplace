# 企业 AI 应用市场 — 后端运行时环境变量（应用层 192.168.1.132）
# 部署位置：/aitest/app/config/ai-marketplace.env   权限必须 600，属主 aiuser
#
# 本文件是唯一存放明文口令的地方，不要提交到代码库、不要复制到聊天工具。
# 键名与 backend/src/main/resources/application.yml 中的 ${XXX:默认值} 一一对应。
# DB_PASSWORD / REDIS_PASSWORD / JWT_SECRET 三项由 setup-app-server.sh 部署时替换为随机值。

# ---------- 数据库（数据层 131）----------
DB_HOST=192.168.1.131
DB_PORT=3306
DB_NAME=ai_marketplace
DB_USER=ai_market
DB_PWD=__DB_PASSWORD__

# ---------- Redis（数据层 131）----------
REDIS_HOST=192.168.1.131
REDIS_PORT=6379
REDIS_PWD=__REDIS_PASSWORD__

# ---------- 登录方式 ----------
# 账号密码登录是正式入口，对应后端 app.auth.local-login-enabled，保持 true。
AUTH_LOCAL_LOGIN_ENABLED=true
# 管理员新建用户时的初始口令，对应 app.auth.default-password。
# 用户首次登录会被强制改密（sys_user.must_change_password=1）。
# 仓库里 schema.sql 带的默认值已随代码公开，生产环境务必改成自己的值。
AUTH_DEFAULT_PASSWORD=__AUTH_DEFAULT_PASSWORD__

# ---------- JWT ----------
# HS256 密钥，长度必须足够；泄露等于任何人可伪造登录态，更换后所有已发 token 失效
JWT_SECRET=__JWT_SECRET__

# ---------- 文件存储 ----------
# 作品包落盘根目录，按 {basePath}/{yyyyMMdd}/{uuid}{ext} 组织
STORAGE_BASE_PATH=/aitest/storage/files

# ---------- 通知 ----------
# 企微 SSO 与企微消息推送已随账号密码改造一并下线，
# 原 WECOM_* 变量后端不再读取。当前通知仅写日志，默认关闭。
NOTIFICATION_ENABLED=false

# ---------- AI 评审（v1 关闭）----------
REVIEW_AI_ENABLED=false
REVIEW_AI_ENDPOINT=
REVIEW_AI_API_KEY=
