# 默认: 由 git 自动识别文本文件, 仓库内统一以 LF 存储
* text=auto eol=lf

# Shell 脚本必须使用 LF (在 Linux 服务器运行)
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.override text eol=lf

# Windows 批处理脚本使用 CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# 二进制文件, 不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.war binary
*.zip binary
*.gz binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
